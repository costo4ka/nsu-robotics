<?xml version="1.0"?>
<!--
  Ackermann-робот курса. Размеры и массы взяты из .course-kit/v1/models/course_ackermann/model.sdf
  (только как источник чисел; плагины Gazebo сюда не переносятся).
  Единицы СИ: метры, килограммы, радианы. Оси REP-103: x вперёд, y влево, z вверх.
  base_link — центр между осями на высоте осей колёс; base_footprint — под ним на земле.
-->
<robot name="course_ackermann" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Шасси -->
  <xacro:property name="wheelbase" value="0.8"/>        <!-- база: передняя ось − задняя, м -->
  <xacro:property name="track" value="0.62"/>           <!-- колея: левое колесо − правое, м -->
  <xacro:property name="wheel_radius" value="0.12"/>
  <xacro:property name="wheel_width" value="0.07"/>
  <xacro:property name="wheel_mass" value="0.8"/>
  <xacro:property name="knuckle_mass" value="0.2"/>
  <xacro:property name="steering_limit" value="0.55"/>  <!-- рад -->

  <!-- Корпус -->
  <xacro:property name="body_length" value="1.05"/>
  <xacro:property name="body_width" value="0.52"/>
  <xacro:property name="body_height" value="0.22"/>
  <xacro:property name="body_z" value="0.12"/>          <!-- центр корпуса над base_link -->
  <xacro:property name="body_mass" value="12.0"/>

  <!-- Сенсоры: в SDF камера, лидар и IMU закреплены в одной точке относительно base_link -->
  <xacro:property name="sensor_x" value="0.28"/>
  <xacro:property name="sensor_y" value="0.0"/>
  <xacro:property name="sensor_z" value="0.38"/>
  <xacro:property name="sensor_mass" value="0.0333"/>
  <!-- Корпуса сенсоров (только для показа, столкновений и инерции) -->
  <xacro:property name="camera_x" value="0.03"/>
  <xacro:property name="camera_y" value="0.09"/>
  <xacro:property name="camera_z" value="0.03"/>
  <xacro:property name="lidar_radius" value="0.05"/>
  <xacro:property name="lidar_length" value="0.05"/>
  <xacro:property name="imu_x" value="0.02"/>
  <xacro:property name="imu_y" value="0.02"/>
  <xacro:property name="imu_z" value="0.01"/>

  <!-- Тензоры инерции однородных тел: заведомо физически допустимы -->
  <xacro:macro name="box_inertial" params="mass x y z *origin">
    <inertial>
      <xacro:insert_block name="origin"/>
      <mass value="${mass}"/>
      <inertia ixx="${mass * (y * y + z * z) / 12}" ixy="0" ixz="0"
               iyy="${mass * (x * x + z * z) / 12}" iyz="0"
               izz="${mass * (x * x + y * y) / 12}"/>
    </inertial>
  </xacro:macro>

  <!-- Ось цилиндра — z его собственной системы; origin поворачивает её куда нужно -->
  <xacro:macro name="cylinder_inertial" params="mass radius length *origin">
    <inertial>
      <xacro:insert_block name="origin"/>
      <mass value="${mass}"/>
      <inertia ixx="${mass * (3 * radius * radius + length * length) / 12}" ixy="0" ixz="0"
               iyy="${mass * (3 * radius * radius + length * length) / 12}" iyz="0"
               izz="${mass * radius * radius / 2}"/>
    </inertial>
  </xacro:macro>

  <material name="body_blue"><color rgba="0.05 0.36 0.72 1"/></material>
  <material name="tire_black"><color rgba="0.04 0.04 0.04 1"/></material>
  <material name="sensor_grey"><color rgba="0.6 0.6 0.6 1"/></material>

  <!-- REP-105: base_footprint — проекция base_link на землю. Корень без инерции:
       KDL в robot_state_publisher не поддерживает инерцию у корневого звена. -->
  <link name="base_footprint"/>
  <joint name="base_footprint_to_base" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${wheel_radius}"/>
  </joint>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 ${body_z}"/>
      <geometry><box size="${body_length} ${body_width} ${body_height}"/></geometry>
      <material name="body_blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${body_z}"/>
      <geometry><box size="${body_length} ${body_width} ${body_height}"/></geometry>
    </collision>
    <xacro:box_inertial mass="${body_mass}" x="${body_length}" y="${body_width}" z="${body_height}">
      <origin xyz="0 0 ${body_z}"/>
    </xacro:box_inertial>
  </link>

  <!-- Колесо: ось вращения — y звена, цилиндр повёрнут на 90° вокруг x -->
  <xacro:macro name="wheel" params="name parent x y">
    <link name="${name}_wheel">
      <visual>
        <origin rpy="${pi / 2} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        <material name="tire_black"/>
      </visual>
      <collision>
        <origin rpy="${pi / 2} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      </collision>
      <xacro:cylinder_inertial mass="${wheel_mass}" radius="${wheel_radius}" length="${wheel_width}">
        <origin rpy="${pi / 2} 0 0"/>
      </xacro:cylinder_inertial>
    </link>
    <joint name="${name}_wheel_joint" type="continuous">
      <parent link="${parent}"/>
      <child link="${name}_wheel"/>
      <origin xyz="${x} ${y} 0"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <!-- Поворотный кулак переднего колеса: рулевое сочленение вокруг z -->
  <xacro:macro name="steered_wheel" params="name x y">
    <link name="${name}_knuckle">
      <inertial>
        <mass value="${knuckle_mass}"/>
        <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
      </inertial>
    </link>
    <joint name="${name}_steering_joint" type="revolute">
      <parent link="base_link"/>
      <child link="${name}_knuckle"/>
      <origin xyz="${x} ${y} 0"/>
      <axis xyz="0 0 1"/>
      <limit lower="${-steering_limit}" upper="${steering_limit}" effort="25" velocity="2.0"/>
    </joint>
    <xacro:wheel name="${name}" parent="${name}_knuckle" x="0" y="0"/>
  </xacro:macro>

  <xacro:steered_wheel name="front_left" x="${wheelbase / 2}" y="${track / 2}"/>
  <xacro:steered_wheel name="front_right" x="${wheelbase / 2}" y="${-track / 2}"/>
  <xacro:wheel name="rear_left" parent="base_link" x="${-wheelbase / 2}" y="${track / 2}"/>
  <xacro:wheel name="rear_right" parent="base_link" x="${-wheelbase / 2}" y="${-track / 2}"/>

  <!-- Сенсор: звено с отдельной геометрией отображения и столкновений, фиксированно на корпусе -->
  <xacro:macro name="sensor" params="name joint parent:=base_link *geometry *inertial">
    <link name="${name}">
      <visual>
        <xacro:insert_block name="geometry"/>
        <material name="sensor_grey"/>
      </visual>
      <collision>
        <xacro:insert_block name="geometry"/>
      </collision>
      <xacro:insert_block name="inertial"/>
    </link>
    <joint name="${joint}" type="fixed">
      <parent link="${parent}"/>
      <child link="${name}"/>
      <origin xyz="${sensor_x} ${sensor_y} ${sensor_z}" rpy="0 0 0"/>
    </joint>
  </xacro:macro>

  <xacro:sensor name="camera_link" joint="base_to_camera">
    <geometry><box size="${camera_x} ${camera_y} ${camera_z}"/></geometry>
    <xacro:box_inertial mass="${sensor_mass}" x="${camera_x}" y="${camera_y}" z="${camera_z}">
      <origin xyz="0 0 0"/>
    </xacro:box_inertial>
  </xacro:sensor>
  <xacro:sensor name="lidar_link" joint="base_to_lidar">
    <geometry><cylinder radius="${lidar_radius}" length="${lidar_length}"/></geometry>
    <xacro:cylinder_inertial mass="${sensor_mass}" radius="${lidar_radius}" length="${lidar_length}">
      <origin xyz="0 0 0"/>
    </xacro:cylinder_inertial>
  </xacro:sensor>
  <xacro:sensor name="imu_link" joint="base_to_imu">
    <geometry><box size="${imu_x} ${imu_y} ${imu_z}"/></geometry>
    <xacro:box_inertial mass="${sensor_mass}" x="${imu_x}" y="${imu_y}" z="${imu_z}">
      <origin xyz="0 0 0"/>
    </xacro:box_inertial>
  </xacro:sensor>

  <!-- Оптическая система камеры (REP-103): z вперёд, x вправо, y вниз -->
  <link name="camera_link_optical"/>
  <joint name="camera_to_optical" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_link_optical"/>
    <origin xyz="0 0 0" rpy="${-pi / 2} 0 ${-pi / 2}"/>
  </joint>

</robot>
