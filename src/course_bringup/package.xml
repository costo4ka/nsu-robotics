<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>course_bringup</name>
  <version>0.0.0</version>
  <description>Bringup: patrol, pose_relay and a QoS-configurable listener, MCAP recording</description>
  <maintainer email="a.tebaikina@g.nsu.ru">arina</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>rcl_interfaces</depend>
  <depend>turtlesim</depend>
  <depend>launch</depend>
  <depend>launch_ros</depend>

  <exec_depend>patrol</exec_depend>
  <exec_depend>ros2bag</exec_depend>
  <exec_depend>rosbag2_storage_mcap</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
